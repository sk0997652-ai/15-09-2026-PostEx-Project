SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Feature Flags (Default: false in production)
VITE_ENABLE_DEV_TOOLS=false

# Email Delivery Provider: "smtp" or "log" (Default: "log")
EMAIL_PROVIDER=log

# SMTP Server Settings (Required only when EMAIL_PROVIDER=smtp)
# SMTP_HOST: The hostname of your SMTP mail server (e.g. smtp.postmarkapp.com, smtp.sendgrid.net)
SMTP_HOST=smtp.example.com
# SMTP_PORT: Port for outgoing mail (587 for STARTTLS, 465 for SSL/TLS, 25 for plain)
SMTP_PORT=587
# SMTP_SECURE: Set to true if connecting to port 465 (SSL/TLS), or false for STARTTLS on port 587
SMTP_SECURE=false
# SMTP_USER: Username / API key for SMTP authentication
SMTP_USER=
# SMTP_PASS: Password / secret key for SMTP authentication (Never commit secrets)
SMTP_PASS=
# EMAIL_FROM: Display name and sender email address for outgoing HR notifications
EMAIL_FROM="PostEx HR" <noreply@postex.pk>
